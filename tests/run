#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

jq -e '.id == "coding-sparrow.devkit" and (.keepLoaded != true) and (.kinds | index("panel")) and (.kinds | index("bar-widget"))' manifest.json >/dev/null
bash -n bin/devkit-window
for helper in bin/devkit-hash bin/devkit-clip bin/devkit-regex bin/devkit-helper; do
  python3 -m py_compile "$helper"
done
rm -rf bin/__pycache__
[[ $(printf hello | bin/devkit-hash | jq -r .sha256) == "$(printf hello | sha256sum | cut -d' ' -f1)" ]]
node tests/tools.test.mjs
node tests/perf.test.mjs
# The same cases in Qt's V4, when qt6-declarative's qml runtime is installed.
qml=""
for candidate in /usr/lib/qt6/bin/qml "$(command -v qml6 || true)"; do
  [[ -x $candidate ]] && { qml=$candidate; break; }
done
if [[ -n $qml ]]; then
  QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 QT_MESSAGE_PATTERN='%{message}' \
    timeout 300 "$qml" -a core tests/perf-v4.qml
else
  echo "perf-v4.qml: skipped (no qml runtime)"
fi
python3 tests/helpers.test.py
echo "all tests passed"

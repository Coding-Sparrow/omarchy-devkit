#!/usr/bin/env python3
"""Read the clipboard as text, with a hard size limit and a hard deadline.

The clipboard owner controls what wl-paste streams, and it can stream
without end. This helper bounds it before anything reaches the shell:
it reads at most LIMIT_BYTES + 1 bytes and gives up after DEADLINE_S
seconds, killing wl-paste in both cases.

Output is one status line, then the text only when the status is "ok":

    ok\\n<clipboard text>
    image\\n<mime>      an image and no text (DevKit offers its image tools)
    empty\\n            nothing on the clipboard, or no text type offered
    too-large\\n        more than LIMIT_BYTES
    timeout\\n          the owner did not finish within DEADLINE_S
    unavailable\\n      wl-paste could not be started
"""

import os
import select
import signal
import subprocess
import sys
import time

LIMIT_BYTES = 1 << 20  # 1 MiB
DEADLINE_S = 2.0


def kill_group(proc):
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    proc.wait()


TEXT_TYPES = ("text/", "UTF8_STRING", "STRING", "TEXT", "COMPOUND_TEXT")
TYPES_DEADLINE_S = 0.5


def offered_types(deadline):
    """The clipboard's MIME types, or None if they could not be listed in time."""
    status, data = bounded(["wl-paste", "--list-types"], min(deadline, time.monotonic() + TYPES_DEADLINE_S), 65536)
    if status != "ok":
        return None
    return [t.strip() for t in data.decode("utf-8", "replace").splitlines() if t.strip()]


def read_clipboard():
    deadline = time.monotonic() + DEADLINE_S
    types = offered_types(deadline)
    if types is not None and types and not any(t.startswith(TEXT_TYPES) for t in types):
        image = next((t for t in types if t.startswith("image/")), None)
        if image:
            return "image", image.encode()
    return bounded(["wl-paste", "--no-newline", "--type", "text"], deadline, LIMIT_BYTES)


def bounded(argv, deadline, limit):
    try:
        proc = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        return "unavailable", b""

    fd = proc.stdout.fileno()
    os.set_blocking(fd, False)
    data = bytearray()
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            kill_group(proc)
            return "timeout", b""
        ready, _, _ = select.select([fd], [], [], remaining)
        if not ready:
            kill_group(proc)
            return "timeout", b""
        try:
            chunk = os.read(fd, 65536)
        except BlockingIOError:
            continue
        if not chunk:
            break
        data += chunk
        if len(data) > limit:
            kill_group(proc)
            return "too-large", b""

    try:
        code = proc.wait(timeout=max(0.05, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        kill_group(proc)
        return "timeout", b""
    if code != 0 or not data:
        return "empty", b""
    return "ok", bytes(data)


def main():
    status, data = read_clipboard()
    out = sys.stdout.buffer
    out.write(status.encode() + b"\n")
    if status in ("ok", "image"):
        out.write(data)
    out.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())

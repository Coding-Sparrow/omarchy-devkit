#!/usr/bin/env python3
"""The parts of DevKit that cannot be plain JavaScript in the shell.

    devkit-helper <command> < {json request}   ->   one JSON object on stdout

Commands:

    hash          {text | path, key}           -> {digests, bytes, hmac, path?}
    jwt-verify    {signingInput, signature, alg, key, keyBase64} -> {valid}
    jwt-sign      {signingInput, alg, key, keyBase64}            -> {signature}
    qr            {text, level}                -> {path, modules, version}
    qr-read       {path | clipboard: true}     -> {codes: [{type, data}], path}
    image-decode  {base64, mime}               -> {path, mime, width, height, bytes}
    image-encode  {path | clipboard: true}     -> {base64, mime, width, height, bytes, path}
    image-copy    {path}                       -> {ok}      (image onto the clipboard)
    image-save    {path, name}                 -> {saved}   (into ~/Pictures)

Requests arrive on stdin, never in argv, because argv is visible to every
process through /proc/<pid>/cmdline and requests carry secrets, tokens and
keys. Images DevKit makes or reads live in an owner-only (0700) directory
under $XDG_RUNTIME_DIR, which the session removes at logout; only the newest
few are kept. Every external program gets a deadline. Errors come back as
{"error": "..."}, never as a traceback.
"""

import base64
import binascii
import hashlib
import hmac
import json
import os
import re
import secrets
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import time
import zlib

MAX_REQUEST_BYTES = 32 * 1024 * 1024
MAX_IMAGE_BYTES = 16 * 1024 * 1024
MAX_ENCODE_BYTES = 8 * 1024 * 1024
KEEP_FILES = 12
RUN_TIMEOUT_S = 10


class Fail(Exception):
    pass


def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


# ---------------------------------------------------------------- files

def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    path = os.path.join(base, "coding-sparrow-devkit")
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.lstat(path)
    if not os.path.isdir(path) or os.path.islink(path) or st.st_uid != os.getuid():
        raise Fail("Unsafe runtime directory " + path)
    os.chmod(path, 0o700)
    return path


def prune(directory):
    files = [os.path.join(directory, f) for f in os.listdir(directory)]
    files = [f for f in files if os.path.isfile(f)]
    files.sort(key=lambda f: os.path.getmtime(f), reverse=True)
    for old in files[KEEP_FILES:]:
        try:
            os.unlink(old)
        except OSError:
            pass


EXTENSIONS = {"image/png": "png", "image/jpeg": "jpg", "image/gif": "gif", "image/webp": "webp", "image/bmp": "bmp",
              "image/svg+xml": "svg", "image/x-icon": "ico", "image/tiff": "tiff", "image/avif": "avif", "image/heic": "heic"}


def new_file(kind, mime):
    directory = runtime_dir()
    prune(directory)
    name = "%s-%d-%s.%s" % (kind, int(time.time()), secrets.token_hex(4), EXTENSIONS.get(mime, "bin"))
    return os.path.join(directory, name)


def write_private(path, data):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as handle:
        handle.write(data)


def ours(path):
    """Only files DevKit wrote itself may be copied or saved."""
    real = os.path.realpath(path)
    return os.path.dirname(real) == os.path.realpath(runtime_dir()) and os.path.isfile(real)


def user_file(path, limit):
    path = os.path.realpath(os.path.expanduser(path.strip()))
    if not os.path.isfile(path):
        raise Fail("No such file: " + path)
    size = os.path.getsize(path)
    if size > limit:
        raise Fail("File is larger than %d MiB" % (limit // (1024 * 1024)))
    with open(path, "rb") as handle:
        return path, handle.read(limit + 1)


# ---------------------------------------------------------------- processes

def run(argv, data=b"", timeout=RUN_TIMEOUT_S, limit=MAX_IMAGE_BYTES):
    """Run a program with a deadline and a bounded output; kill its group on overrun."""
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                start_new_session=True)
    except OSError:
        raise Fail(argv[0] + " is not installed")
    try:
        out, err = proc.communicate(data, timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
        proc.wait()
        raise Fail(argv[0] + " did not finish in %d s" % timeout)
    if len(out) > limit:
        raise Fail(argv[0] + " returned too much data")
    return proc.returncode, out, err


def read_clipboard_image():
    code, out, _ = run(["wl-paste", "--list-types"], timeout=2, limit=65536)
    types = [t.strip() for t in out.decode("utf-8", "replace").splitlines()] if code == 0 else []
    order = ["image/png", "image/jpeg", "image/webp", "image/gif", "image/bmp", "image/svg+xml"]
    pick = next((t for t in order if t in types), None) or next((t for t in types if t.startswith("image/")), None)
    if not pick:
        raise Fail("The clipboard has no image. Copy one (a screenshot works) and try again")
    code, data, _ = run(["wl-paste", "--no-newline", "--type", pick], timeout=4, limit=MAX_IMAGE_BYTES)
    if code != 0 or not data:
        raise Fail("Could not read the image from the clipboard")
    return pick, data


# ---------------------------------------------------------------- images

def sniff(data):
    if data[:8] == b"\x89PNG\r\n\x1a\n":
        return "image/png"
    if data[:3] == b"\xff\xd8\xff":
        return "image/jpeg"
    if data[:4] == b"GIF8":
        return "image/gif"
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "image/webp"
    if data[:2] == b"BM":
        return "image/bmp"
    if data[:4] == b"\x00\x00\x01\x00":
        return "image/x-icon"
    if data[:4] in (b"II*\x00", b"MM\x00*"):
        return "image/tiff"
    if data[4:8] == b"ftyp":
        brand = data[8:12]
        if brand in (b"avif", b"avis"):
            return "image/avif"
        if brand in (b"heic", b"heix", b"mif1", b"msf1"):
            return "image/heic"
    head = data[:1024].decode("utf-8", "ignore").lstrip()
    if re.match(r"^(<\?xml[^>]*>\s*)?(<!--.*?-->\s*)*(<!DOCTYPE svg[^>]*>\s*)?<svg[\s>]", head, re.S | re.I):
        return "image/svg+xml"
    return ""


def dimensions(data, mime):
    try:
        if mime == "image/png" and data[12:16] == b"IHDR":
            return struct.unpack(">II", data[16:24])
        if mime == "image/gif":
            return struct.unpack("<HH", data[6:10])
        if mime == "image/bmp":
            w, h = struct.unpack("<ii", data[18:26])
            return w, abs(h)
        if mime == "image/webp":
            chunk = data[12:16]
            if chunk == b"VP8 ":
                w, h = struct.unpack("<HH", data[26:30])
                return w & 0x3FFF, h & 0x3FFF
            if chunk == b"VP8L":
                b = data[21:25]
                w = 1 + (((b[1] & 0x3F) << 8) | b[0])
                h = 1 + (((b[3] & 0x0F) << 10) | (b[2] << 2) | ((b[1] & 0xC0) >> 6))
                return w, h
            if chunk == b"VP8X":
                return 1 + int.from_bytes(data[24:27], "little"), 1 + int.from_bytes(data[27:30], "little")
        if mime == "image/jpeg":
            i = 2
            while i + 9 < len(data):
                if data[i] != 0xFF:
                    i += 1
                    continue
                marker = data[i + 1]
                if marker in (0xD8, 0x01) or 0xD0 <= marker <= 0xD7:
                    i += 2
                    continue
                length = struct.unpack(">H", data[i + 2:i + 4])[0]
                if 0xC0 <= marker <= 0xCF and marker not in (0xC4, 0xC8, 0xCC):
                    h, w = struct.unpack(">HH", data[i + 5:i + 9])
                    return w, h
                i += 2 + length
        if mime == "image/svg+xml":
            head = data[:4096].decode("utf-8", "ignore")
            tag = re.search(r"<svg[^>]*>", head, re.S)
            if tag:
                w = re.search(r'\bwidth="([\d.]+)', tag.group(0))
                h = re.search(r'\bheight="([\d.]+)', tag.group(0))
                if w and h:
                    return int(float(w.group(1))), int(float(h.group(1)))
                vb = re.search(r'viewBox="[\d.-]+[\s,]+[\d.-]+[\s,]+([\d.]+)[\s,]+([\d.]+)', tag.group(0))
                if vb:
                    return int(float(vb.group(1))), int(float(vb.group(2)))
    except (struct.error, IndexError, ValueError):
        pass
    return 0, 0


def image_info(data, path, mime=None):
    mime = mime or sniff(data)
    w, h = dimensions(data, mime)
    return {"path": path, "mime": mime, "width": w, "height": h, "bytes": len(data)}


def image_decode(req):
    text = re.sub(r"\s+", "", str(req.get("base64", "")))
    text = text.replace("-", "+").replace("_", "/")
    text += "=" * (-len(text) % 4)
    if len(text) > MAX_IMAGE_BYTES * 4 // 3 + 4:
        raise Fail("Image is larger than %d MiB" % (MAX_IMAGE_BYTES // (1024 * 1024)))
    try:
        data = base64.b64decode(text, validate=True)
    except (binascii.Error, ValueError):
        raise Fail("Not valid Base64")
    mime = sniff(data)
    if not mime:
        raise Fail("The decoded bytes are not an image")
    path = new_file("decoded", mime)
    write_private(path, data)
    return image_info(data, path, mime)


def image_encode(req):
    if req.get("clipboard"):
        _, data = read_clipboard_image()
    else:
        _, data = user_file(str(req.get("path", "")), MAX_ENCODE_BYTES)
    if len(data) > MAX_ENCODE_BYTES:
        raise Fail("Image is larger than %d MiB; a data: URI that big is no fun" % (MAX_ENCODE_BYTES // (1024 * 1024)))
    mime = sniff(data)
    if not mime:
        raise Fail("That file is not an image")
    path = new_file("source", mime)
    write_private(path, data)
    info = image_info(data, path, mime)
    info["base64"] = base64.b64encode(data).decode()
    return info


def image_copy(req):
    path = str(req.get("path", ""))
    if not ours(path):
        raise Fail("Not an image DevKit made")
    with open(path, "rb") as handle:
        data = handle.read()
    mime = sniff(data) or "image/png"
    try:
        subprocess.Popen(["wl-copy", "--type", mime], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True).communicate(data, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        raise Fail("wl-copy failed")
    return {"ok": True, "mime": mime}


def pictures_dir():
    try:
        code, out, _ = run(["xdg-user-dir", "PICTURES"], timeout=2, limit=4096)
        path = out.decode().strip() if code == 0 else ""
    except Fail:
        path = ""
    if not path or path == os.path.expanduser("~"):
        path = os.path.expanduser("~/Pictures")
    os.makedirs(path, exist_ok=True)
    return path


def image_save(req):
    path = str(req.get("path", ""))
    if not ours(path):
        raise Fail("Not an image DevKit made")
    stem = re.sub(r"[^\w.-]+", "-", str(req.get("name") or "devkit")).strip("-") or "devkit"
    ext = os.path.splitext(path)[1]
    target_dir = pictures_dir()
    target = os.path.join(target_dir, "%s-%s%s" % (stem, time.strftime("%Y%m%d-%H%M%S"), ext))
    n = 2
    while os.path.exists(target):
        target = os.path.join(target_dir, "%s-%s-%d%s" % (stem, time.strftime("%Y%m%d-%H%M%S"), n, ext))
        n += 1
    shutil.copyfile(path, target)
    return {"saved": target}


# ---------------------------------------------------------------- QR

def qr(req):
    text = str(req.get("text", "")).encode("utf-8")
    level = str(req.get("level", "M"))
    if level not in ("L", "M", "Q", "H"):
        level = "M"
    if not text:
        raise Fail("Nothing to encode")
    # One pass at one pixel per module tells the module count; the second is the picture.
    code, small, err = run(["qrencode", "-l", level, "-s", "1", "-m", "0", "-t", "PNG", "-o", "-"], text)
    if code != 0:
        raise Fail((err.decode("utf-8", "replace").strip() or "qrencode failed").splitlines()[-1])
    modules = struct.unpack(">I", small[16:20])[0]
    code, png, err = run(["qrencode", "-l", level, "-s", "12", "-m", "2", "-t", "PNG", "-o", "-"], text)
    if code != 0:
        raise Fail("qrencode failed")
    path = new_file("qr", "image/png")
    write_private(path, png)
    return {"path": path, "modules": modules, "version": (modules - 17) // 4}


def qr_read(req):
    if req.get("clipboard"):
        mime, data = read_clipboard_image()
        path = new_file("clipboard", mime)
        write_private(path, data)
    else:
        path, data = user_file(str(req.get("path", "")), MAX_IMAGE_BYTES)
        if not sniff(data):
            raise Fail("That file is not an image")
    # zbarimg's XML mangles non-ASCII data, so the types come from --xml and
    # the data from --raw -Sbinary, which passes the code's bytes through.
    code, out, err = run(["zbarimg", "--quiet", "--xml", path], timeout=RUN_TIMEOUT_S, limit=4 * 1024 * 1024)
    if code == 4 or (code == 0 and b"<symbol" not in out):
        return {"error": "No QR code or barcode found in this image", "path": path}
    if code != 0:
        raise Fail((err.decode("utf-8", "replace").strip() or "zbarimg failed").splitlines()[-1])
    types = re.findall(rb"<symbol type='([^']+)'", out)
    code, raw, _ = run(["zbarimg", "--quiet", "--raw", "-Sbinary", path], timeout=RUN_TIMEOUT_S, limit=4 * 1024 * 1024)
    text = raw.decode("utf-8", "replace")
    if text.endswith("\n"):
        text = text[:-1]
    kinds = [t.decode("ascii", "replace") for t in types] or ["code"]
    # One code per line when the counts agree; otherwise the text as one block.
    parts = text.split("\n") if len(kinds) > 1 and len(text.split("\n")) == len(kinds) else [text]
    codes = [{"type": kinds[min(i, len(kinds) - 1)], "data": p} for i, p in enumerate(parts)]
    return {"codes": codes, "path": path}


# ---------------------------------------------------------------- hashes

ALGORITHMS = [("md5", "md5"), ("sha1", "sha1"), ("sha224", "sha224"), ("sha256", "sha256"), ("sha384", "sha384"),
              ("sha512", "sha512"), ("sha3_256", "sha3_256"), ("sha3_512", "sha3_512"), ("blake2b", "blake2b"),
              ("blake2s", "blake2s")]
HMAC_ALGORITHMS = ["md5", "sha1", "sha224", "sha256", "sha384", "sha512", "sha3_256", "sha3_512"]


def hash_command(req):
    key = str(req.get("key", "")).encode("utf-8")
    if key:
        hashers = {name: hmac.new(key, digestmod=name) for name in HMAC_ALGORITHMS}
    else:
        hashers = {name: hashlib.new(algo) for name, algo in ALGORITHMS}
    crc = 0
    total = 0
    path = None

    def feed(chunk):
        nonlocal crc, total
        for h in hashers.values():
            h.update(chunk)
        crc = zlib.crc32(chunk, crc)
        total += len(chunk)

    if "path" in req:
        path = os.path.realpath(os.path.expanduser(str(req["path"]).strip()))
        if not os.path.isfile(path):
            raise Fail("No such file: " + path)
        with open(path, "rb") as handle:
            while True:
                chunk = handle.read(1 << 20)
                if not chunk:
                    break
                feed(chunk)
    else:
        feed(str(req.get("text", "")).encode("utf-8"))
    digests = {name: h.hexdigest() for name, h in hashers.items()}
    if not key:
        digests["crc32"] = "%08x" % (crc & 0xFFFFFFFF)
    out = {"digests": digests, "bytes": total, "hmac": bool(key)}
    if path:
        out["path"] = path
    return out


# ---------------------------------------------------------------- JWT

HS = {"HS256": "sha256", "HS384": "sha384", "HS512": "sha512"}
DIGESTS = {"256": "-sha256", "384": "-sha384", "512": "-sha512"}


def b64url_decode(text):
    text = str(text).strip()
    text += "=" * (-len(text) % 4)
    try:
        return base64.urlsafe_b64decode(text)
    except (binascii.Error, ValueError):
        raise Fail("The signature is not valid Base64URL")


def secret_bytes(req):
    key = str(req.get("key", ""))
    if req.get("keyBase64"):
        compact = re.sub(r"\s+", "", key)
        compact += "=" * (-len(compact) % 4)
        try:
            return base64.b64decode(compact.replace("-", "+").replace("_", "/"), validate=True)
        except (binascii.Error, ValueError):
            raise Fail("The secret is not valid Base64")
    return key.encode("utf-8")


def pem(text):
    """A PEM block, rebuilt if a single-line field swallowed its line breaks."""
    m = re.search(r"-----BEGIN ([A-Z0-9 ]+)-----(.*?)-----END \1-----", text, re.S)
    if not m:
        raise Fail("Paste the public key or certificate as PEM (-----BEGIN PUBLIC KEY-----…)")
    body = re.sub(r"\s+", "", m.group(2))
    lines = [body[i:i + 64] for i in range(0, len(body), 64)]
    return m.group(1), "-----BEGIN %s-----\n%s\n-----END %s-----\n" % (m.group(1), "\n".join(lines), m.group(1))


def der_ecdsa(raw):
    """JOSE ECDSA signatures are r||s; OpenSSL wants DER."""
    half = len(raw) // 2

    def integer(b):
        b = b.lstrip(b"\x00") or b"\x00"
        if b[0] & 0x80:
            b = b"\x00" + b
        return b"\x02" + der_len(len(b)) + b

    body = integer(raw[:half]) + integer(raw[half:])
    return b"\x30" + der_len(len(body)) + body


def der_len(n):
    if n < 0x80:
        return bytes([n])
    out = n.to_bytes((n.bit_length() + 7) // 8, "big")
    return bytes([0x80 | len(out)]) + out


def jwt_verify(req):
    alg = str(req.get("alg", ""))
    signing_input = str(req.get("signingInput", "")).encode("ascii", "replace")
    signature = b64url_decode(req.get("signature", ""))
    if alg in HS:
        expected = hmac.new(secret_bytes(req), signing_input, HS[alg]).digest()
        return {"valid": hmac.compare_digest(expected, signature)}
    kind, key_pem = pem(str(req.get("key", "")))
    work = tempfile.mkdtemp(prefix="jwt-", dir=runtime_dir())
    try:
        key_file = os.path.join(work, "key.pem")
        write_private(key_file, key_pem.encode())
        if kind == "CERTIFICATE":
            code, out, _ = run(["openssl", "x509", "-pubkey", "-noout", "-in", key_file], timeout=5, limit=65536)
            if code != 0:
                raise Fail("Could not read that certificate")
            os.unlink(key_file)
            write_private(key_file, out)
        data_file = os.path.join(work, "data")
        sig_file = os.path.join(work, "sig")
        write_private(data_file, signing_input)
        if alg.startswith("ES"):
            sizes = {"ES256": 64, "ES384": 96, "ES512": 132}
            if len(signature) != sizes.get(alg, -1):
                return {"valid": False}
            write_private(sig_file, der_ecdsa(signature))
        else:
            write_private(sig_file, signature)
        if alg in ("EdDSA", "Ed25519"):
            argv = ["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", key_file, "-rawin", "-in", data_file,
                    "-sigfile", sig_file]
        elif alg[:2] in ("RS", "PS", "ES") and alg[2:] in DIGESTS:
            argv = ["openssl", "dgst", DIGESTS[alg[2:]], "-verify", key_file, "-signature", sig_file]
            if alg.startswith("PS"):
                argv[2:2] = ["-sigopt", "rsa_padding_mode:pss", "-sigopt", "rsa_pss_saltlen:auto"]
            argv.append(data_file)
        else:
            raise Fail("Cannot verify alg " + alg)
        code, out, err = run(argv, timeout=5, limit=65536)
        text = (out + err).decode("utf-8", "replace")
        if code == 0 and ("Verified OK" in text or "Signature Verified Successfully" in text):
            return {"valid": True}
        if re.search(r"(unable to load|Could not read|wrong tag|no start line|bad decrypt|expecting)", text, re.I):
            raise Fail("Could not read that key as a public key for " + alg)
        return {"valid": False}
    finally:
        shutil.rmtree(work, ignore_errors=True)


def jwt_sign(req):
    alg = str(req.get("alg", "HS256"))
    if alg not in HS:
        raise Fail("Only HS256, HS384 and HS512 can be signed here")
    signing_input = str(req.get("signingInput", "")).encode("ascii", "replace")
    sig = hmac.new(secret_bytes(req), signing_input, HS[alg]).digest()
    return {"signature": base64.urlsafe_b64encode(sig).decode().rstrip("=")}


COMMANDS = {
    "hash": hash_command, "jwt-verify": jwt_verify, "jwt-sign": jwt_sign, "qr": qr, "qr-read": qr_read,
    "image-decode": image_decode, "image-encode": image_encode, "image-copy": image_copy, "image-save": image_save,
}


def main(argv):
    if len(argv) != 2 or argv[1] not in COMMANDS:
        emit({"error": "usage: devkit-helper " + "|".join(sorted(COMMANDS)) + " < request.json"})
        return 2
    raw = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1)
    if len(raw) > MAX_REQUEST_BYTES:
        emit({"error": "Request too large"})
        return 0
    try:
        req = json.loads(raw.decode("utf-8") or "{}")
        if not isinstance(req, dict):
            raise ValueError
    except (ValueError, UnicodeDecodeError):
        emit({"error": "Invalid request"})
        return 0
    try:
        emit(COMMANDS[argv[1]](req))
    except Fail as e:
        emit({"error": str(e)})
    except OSError as e:
        emit({"error": e.strerror or str(e)})
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
